# GitHub Fine-grained PAT。不要把真实 Token 写入或提交到此文件。
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx

# Cloudflare Turnstile Widget 的 Secret Key，不是公开的 Site Key。
TURNSTILE_SECRET_KEY=0x0000000000000000000000000000000AA

# Upstash Redis 控制台 REST API 区域提供的 URL 和 Token。
UPSTASH_REDIS_REST_URL=https://example-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 只填写 origin，多个地址使用英文逗号分隔，不要包含路径或末尾斜杠。
ALLOWED_ORIGINS=https://xscnet.cn,https://www.xscnet.cn
